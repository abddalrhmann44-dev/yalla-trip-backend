# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── WAAPI (https://waapi.app) ─────────────────────────────────
# Get these from your waapi.app dashboard
WAAPI_BASE_URL=https://waapi.app/api/v1
WAAPI_API_KEY=your_waapi_api_key_here
WAAPI_INSTANCE_ID=your_instance_id_here

# ── Anthropic Claude AI ───────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Model to use (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6
# Max tokens per response
CLAUDE_MAX_TOKENS=1024

# ── Webhook Security ──────────────────────────────────────────
# A secret string you set in your WAAPI webhook config
WEBHOOK_SECRET=your_strong_random_secret_here

# ── Bot Behaviour ─────────────────────────────────────────────
# Ignore messages from WhatsApp groups (true/false)
IGNORE_GROUPS=true
# Ignore broadcast/status messages (true/false)
IGNORE_STATUS=true
# Typing simulation delay in ms (min and max)
TYPING_DELAY_MIN=1000
TYPING_DELAY_MAX=3000
# Conversation history TTL in minutes (0 = never expire)
CONVERSATION_TTL_MINUTES=60
# Max messages kept per conversation
CONVERSATION_MAX_MESSAGES=20

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── System Prompt ─────────────────────────────────────────────
# Customize your bot's personality (optional override)
# BOT_SYSTEM_PROMPT=You are a helpful WhatsApp assistant...
